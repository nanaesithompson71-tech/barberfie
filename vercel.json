{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-WITH-YOUR-RAILWAY-URL.up.railway.app/api/:path*" }
  ],
  "headers": [
    { "source": "/backend/(.*)", "headers": [{ "key": "x-robots-tag", "value": "noindex" }] }
  ]
}
