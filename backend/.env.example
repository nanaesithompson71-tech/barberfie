# Copy to .env and edit. Every backend service reads these same names.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=barberfie
DB_USER=barberfie
DB_PASSWORD=barberfie_dev_password

# Node.js API
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Django reports
DJANGO_SECRET_KEY=change-me-too
DJANGO_DEBUG=1
DJANGO_PORT=8000

# C++ reminder worker
REMINDER_HOURS_AHEAD=24
REMINDER_INTERVAL_SECONDS=300

# Email verification (Node API). Leave SMTP_HOST empty to print emails to the console instead.
APP_URL=http://localhost:5500
MAIL_FROM=BARBERFIE <no-reply@barberfie.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

# Google sign-in (Node API). OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Paystack (Node API). Keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
CURRENCY=GHS
